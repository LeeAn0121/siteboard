<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#FF6E22"
                android:startColor="#0C1118"
                android:type="linear" />
        </shape>
    </item>

    <item android:gravity="center">
        <shape android:shape="oval">
            <size
                android:width="82dp"
                android:height="82dp" />
            <gradient
                android:centerColor="#2EFFB36B"
                android:endColor="#00FFB36B"
                android:startColor="#10FFFFFF"
                android:type="radial"
                android:gradientRadius="52dp" />
        </shape>
    </item>

    <item android:gravity="bottom|end">
        <shape android:shape="rectangle">
            <size
                android:width="72dp"
                android:height="72dp" />
            <gradient
                android:angle="315"
                android:endColor="#00000000"
                android:startColor="#14000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
