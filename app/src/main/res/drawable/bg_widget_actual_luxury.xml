<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2B1C13"
                android:centerColor="#17181C"
                android:endColor="#121318" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#8B5735" />
        </shape>
    </item>
    <item
        android:left="-24dp"
        android:top="-40dp"
        android:right="90dp"
        android:bottom="100dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#22FFB36B"
                android:endColor="#00FFB36B" />
        </shape>
    </item>
</layer-list>

