<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2D221B"
                android:centerColor="#181920"
                android:endColor="#101318" />
            <corners android:radius="30dp" />
            <stroke
                android:width="1dp"
                android:color="#6C4E39" />
        </shape>
    </item>
    <item
        android:left="-44dp"
        android:top="-80dp"
        android:right="150dp"
        android:bottom="130dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#36FFB36B"
                android:endColor="#00FFB36B" />
        </shape>
    </item>
    <item
        android:left="150dp"
        android:top="90dp"
        android:right="-70dp"
        android:bottom="-60dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#16FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
