<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2A1B12"
                android:centerColor="#18130F"
                android:endColor="#101114" />
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#8A5734" />
        </shape>
    </item>
    <item
        android:left="-40dp"
        android:top="-70dp"
        android:right="130dp"
        android:bottom="120dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#30FFB36B"
                android:endColor="#00FFB36B" />
        </shape>
    </item>
    <item
        android:left="160dp"
        android:top="100dp"
        android:right="-80dp"
        android:bottom="-70dp">
        <shape android:shape="oval">
            <gradient
                android:angle="0"
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>

