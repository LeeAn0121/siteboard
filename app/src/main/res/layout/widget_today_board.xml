<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetTodayBoardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_actual_luxury"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="오늘 해야 할 일"
        android:textColor="#8F9FB0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/tvTodayBoardHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="점검 0건 · 즐겨찾기 0건"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTodayBoardLineOne"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_metric_tile"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:text="오늘 기록 0건"
        android:textColor="#E4E8EE"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvTodayBoardLineTwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_metric_tile"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:text="즐겨찾기 현장 없음"
        android:textColor="#C7D0DB"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvTodayBoardLineThree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_metric_tile"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:text="보수 필요 현장 없음"
        android:textColor="#C7D0DB"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/layoutTodayBoardActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTodayBoardAdd"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_primary"
            android:gravity="center"
            android:text="추가"
            android:textColor="#0F1115"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTodayBoardCalendar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_secondary"
            android:gravity="center"
            android:text="캘린더"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTodayBoardRefresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_secondary"
            android:gravity="center"
            android:text="새로고침"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
