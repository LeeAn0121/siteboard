<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16161A">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#FFFFFF"
            android:contentDescription="뒤로가기" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="배치 편집"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0장"
            android:textColor="#FF6F00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutApplyBtn">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Selected Assets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선택된 사진"
                    android:textColor="#A0A0A5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/layoutThumbnails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1EFFFFFF" />

            <!-- Project Context -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="프로젝트 정보"
                    android:textColor="#A0A0A5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Project Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E2023"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="프로젝트명"
                        android:textColor="#606060"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="프로젝트명 입력"
                        android:textColorHint="#404045"
                        android:textColor="#EBEBEB"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp"
                        android:inputType="text"
                        android:maxLines="1" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#0EFFFFFF" />

                <!-- Location / Zone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E2023"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="위치 / 구역"
                        android:textColor="#606060"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="위치 또는 구역 입력"
                        android:textColorHint="#404045"
                        android:textColor="#EBEBEB"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp"
                        android:inputType="text"
                        android:maxLines="1" />
                </LinearLayout>

                <!-- Description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#1E2023"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="작업 내용 (선택)"
                        android:textColor="#606060"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:hint="작업 내용 입력"
                        android:textColorHint="#404045"
                        android:textColor="#EBEBEB"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp"
                        android:inputType="textMultiLine"
                        android:maxLines="2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1EFFFFFF" android:layout_marginTop="12dp"/>

            <!-- Watermark Theme -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="워터마크 테마"
                        android:textColor="#A0A0A5"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/btnDetailSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="상세 설정 ›"
                        android:textColor="#FF6F00"
                        android:textSize="13sp"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:id="@+id/layoutTheme0" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true">
                            <com.google.android.material.card.MaterialCardView android:id="@+id/viewTheme0" android:layout_width="match_parent" android:layout_height="80dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="#252529" app:strokeWidth="0dp" app:strokeColor="#FF6F00">
                                <ImageView android:id="@+id/ivThemePreview0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:id="@+id/tvThemeLabel0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="미니멀" android:textColor="#A0A0A5" android:textSize="11sp" android:gravity="center" android:layout_marginTop="5dp" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/layoutTheme1" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true">
                            <com.google.android.material.card.MaterialCardView android:id="@+id/viewTheme1" android:layout_width="match_parent" android:layout_height="80dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="#252529" app:strokeWidth="0dp" app:strokeColor="#FF6F00">
                                <ImageView android:id="@+id/ivThemePreview1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:id="@+id/tvThemeLabel1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="기술" android:textColor="#A0A0A5" android:textSize="11sp" android:gravity="center" android:layout_marginTop="5dp" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/layoutTheme2" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="10dp" android:clickable="true" android:focusable="true">
                            <com.google.android.material.card.MaterialCardView android:id="@+id/viewTheme2" android:layout_width="match_parent" android:layout_height="80dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="#252529" app:strokeWidth="0dp" app:strokeColor="#FF6F00">
                                <ImageView android:id="@+id/ivThemePreview2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:id="@+id/tvThemeLabel2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="전문" android:textColor="#A0A0A5" android:textSize="11sp" android:gravity="center" android:layout_marginTop="5dp" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/layoutTheme3" android:layout_width="80dp" android:layout_height="wrap_content" android:orientation="vertical" android:clickable="true" android:focusable="true">
                            <com.google.android.material.card.MaterialCardView android:id="@+id/viewTheme3" android:layout_width="match_parent" android:layout_height="80dp" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="#252529" app:strokeWidth="0dp" app:strokeColor="#FF6F00">
                                <ImageView android:id="@+id/ivThemePreview3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
                            </com.google.android.material.card.MaterialCardView>
                            <TextView android:id="@+id/tvThemeLabel3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="강조" android:textColor="#A0A0A5" android:textSize="11sp" android:gravity="center" android:layout_marginTop="5dp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1EFFFFFF" android:layout_marginTop="12dp"/>

            <!-- Anchor Point -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="워터마크 위치"
                    android:textColor="#A0A0A5"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="14dp" />

                <!-- 3x3 Grid -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <View android:id="@+id/anchor0" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                        <View android:id="@+id/anchor1" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                        <View android:id="@+id/anchor2" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <View android:id="@+id/anchor3" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                        <View android:id="@+id/anchor4" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                        <View android:id="@+id/anchor5" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <View android:id="@+id/anchor6" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_selected" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                        <View android:id="@+id/anchor7" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                        <View android:id="@+id/anchor8" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/anchor_cell_normal" android:layout_margin="4dp" android:clickable="true" android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1EFFFFFF" android:layout_marginTop="12dp"/>

            <!-- Overlay Opacity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="배경 박스 투명도"
                        android:textColor="#A0A0A5"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvOpacityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="40%"
                        android:textColor="#FF6F00"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekbarOpacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="40"
                    android:progressTint="#FF6F00"
                    android:thumbTint="#FF6F00" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Apply button -->
    <LinearLayout
        android:id="@+id/layoutApplyBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp"
        android:background="#16161A"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btnApplyAll"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="모든 사진에 적용"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#FF6F00"
            android:textAllCaps="false"
            app:cornerRadius="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#FF6F00" />

        <TextView
            android:id="@+id/tvLoadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="처리 중..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>