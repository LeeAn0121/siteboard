<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:id="@+id/layoutTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton android:id="@+id/btnBack" android:layout_width="48dp" android:layout_height="48dp" android:src="@android:drawable/ic_menu_revert" android:background="?attr/selectableItemBackgroundBorderless" app:tint="?android:attr/textColorPrimary"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="워터마크 상세 설정" android:textSize="20sp" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary" android:layout_marginStart="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTop"
        app:layout_constraintBottom_toTopOf="@id/btnSaveSettings"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="미리보기 (Preview)" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="8dp"/>
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="250dp" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="24dp">
                <ImageView android:id="@+id/ivPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="기본 위치 지정" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="8dp"/>
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <RadioGroup android:id="@+id/rgVertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <RadioButton android:id="@+id/rbTop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="상단 (Top)" android:textColor="?android:attr/textColorPrimary" android:buttonTint="#FF6F00"/>
                        <RadioButton android:id="@+id/rbBottom" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="하단 (Bottom)" android:textColor="?android:attr/textColorPrimary" android:buttonTint="#FF6F00"/>
                    </RadioGroup>
                    <RadioGroup android:id="@+id/rgHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <RadioButton android:id="@+id/rbLeft" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="좌측 (Left)" android:textColor="?android:attr/textColorPrimary" android:buttonTint="#FF6F00"/>
                        <RadioButton android:id="@+id/rbRight" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="우측 (Right)" android:textColor="?android:attr/textColorPrimary" android:buttonTint="#FF6F00"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="디테일 미세 조정 (직접 입력 가능)" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="8dp"/>
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface" android:layout_marginBottom="24dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="가로 여백 (X)" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <EditText android:id="@+id/etMarginX" android:layout_width="60dp" android:layout_height="36dp" android:background="#22888888" android:gravity="center" android:inputType="number" android:imeOptions="actionDone" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="px" android:textColor="?android:attr/textColorSecondary" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/sbMarginX" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:progressTint="#FF6F00" android:thumbTint="#FF6F00" android:layout_marginBottom="20dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="세로 여백 (Y)" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <EditText android:id="@+id/etMarginY" android:layout_width="60dp" android:layout_height="36dp" android:background="#22888888" android:gravity="center" android:inputType="number" android:imeOptions="actionDone" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="px" android:textColor="?android:attr/textColorSecondary" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/sbMarginY" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="300" android:progressTint="#FF6F00" android:thumbTint="#FF6F00" android:layout_marginBottom="20dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="글씨 크기" android:textStyle="bold" android:textColor="?android:attr/textColorPrimary"/>
                        <EditText android:id="@+id/etFontSize" android:layout_width="60dp" android:layout_height="36dp" android:background="#22888888" android:gravity="center" android:inputType="number" android:imeOptions="actionDone" android:textColor="?android:attr/textColorPrimary" android:textSize="14sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="pt" android:textColor="?android:attr/textColorSecondary" android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <SeekBar android:id="@+id/sbFontSize" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:progressTint="#FF6F00" android:thumbTint="#FF6F00"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="글꼴 및 색상 커스텀" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="8dp"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="스타일" android:textStyle="bold" android:textColor="?android:attr/textColorSecondary" android:layout_marginBottom="8dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="글꼴 (폰트) 선택"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/spinnerFont"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="24dp"
                        android:background="#22888888" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="글자 색상 (RGB &amp; HEX)"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <androidx.cardview.widget.CardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="2dp">

                            <View
                                android:id="@+id/viewColorPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#FFFF00" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="HEX: #"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/etHexColor"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="4dp"
                            android:background="@null"
                            android:inputType="textCapCharacters"
                            android:maxLength="6"
                            android:text="FFFF00"
                            android:textColor="?android:attr/textColorPrimary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Red (빨강): 255"
                        android:textColor="#FF4444"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sbRed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:max="255"
                        android:progressTint="#FF4444"
                        android:thumbTint="#FF4444" />

                    <TextView
                        android:id="@+id/tvGreen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Green (초록): 255"
                        android:textColor="#44BB44"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sbGreen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:max="255"
                        android:progressTint="#44BB44"
                        android:thumbTint="#44BB44" />

                    <TextView
                        android:id="@+id/tvBlue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blue (파랑): 0"
                        android:textColor="#4444FF"
                        android:textStyle="bold" />

                    <SeekBar
                        android:id="@+id/sbBlue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="255"
                        android:progressTint="#4444FF"
                        android:thumbTint="#4444FF" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:cardBackgroundColor="?attr/colorSurface">
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchBgBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="반투명 배경 박스 (글씨 강조)"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="#FF6F00"/>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSaveSettings"
        android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_margin="20dp" android:text="설정 저장하기"
        android:textColor="#FFFFFF" android:textStyle="bold"
        android:backgroundTint="#FF6F00" app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>