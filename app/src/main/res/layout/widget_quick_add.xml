<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetQuickAddRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_actual_luxury"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="빠른 등록"
        android:textColor="#8F9FB0"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnWidgetQuickAdd"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_primary"
            android:gravity="center"
            android:text="+ 새 기록"
            android:textColor="#0F1115"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWidgetOpenArchive"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_secondary"
            android:gravity="center"
            android:text="보관함"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="촬영과 저장으로 바로 진입"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp" />
</LinearLayout>
