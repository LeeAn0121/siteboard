<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현장 정보 입력"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText android:id="@+id/etTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="제목 (필수)" />
        <EditText android:id="@+id/etDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:hint="설명 (옵션)" />

        <EditText android:id="@+id/etLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:hint="위치 (옵션)" />

        <TextView android:id="@+id/tvThemeLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="워터마크 테마 선택" android:textColor="#666666" android:layout_marginBottom="8dp"/>

        <RadioGroup android:id="@+id/rgTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">
            <RadioButton android:id="@+id/rbLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="밝게(흰 배경)" android:checked="true" android:layout_weight="1"/>
            <RadioButton android:id="@+id/rbDark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="어둡게(검은 배경)" android:layout_weight="1"/>
        </RadioGroup>

        <TextView android:id="@+id/tvPhotoLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="사진 첨부 및 자동 저장" android:textColor="#666666" android:layout_marginBottom="8dp"/>

        <LinearLayout android:id="@+id/layoutPhotoButtons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/btnGallery" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:text="갤러리 선택" />
            <Button android:id="@+id/btnCamera" android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="카메라 촬영" />
        </LinearLayout>

        <Button android:id="@+id/btnEditSave" android:layout_width="match_parent" android:layout_height="60dp" android:text="수정 완료" android:visibility="gone" android:backgroundTint="#FF5722"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="사진 합성 및 저장 중..." android:textColor="#FFFFFF" android:layout_marginTop="16dp"/>
    </LinearLayout>

</FrameLayout>