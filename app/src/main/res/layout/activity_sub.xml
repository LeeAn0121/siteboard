<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#16161A">

    <!-- 헤더 -->
    <LinearLayout
        android:id="@+id/layoutSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="현장 기록 정보 입력"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnDetailSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="워터마크 설정 ›"
            android:textColor="#FF6F00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSubHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Preview Image -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#252529">
                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <TextView
                    android:id="@+id/tvPreviewHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:background="#66000000"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="탭하여 미리보기 사진 선택"
                    android:textColor="#AAFFFFFF"
                    android:textSize="11sp" />
            </androidx.cardview.widget.CardView>

            <Space android:layout_width="match_parent" android:layout_height="20dp" />

            <!-- Input: 현장명 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="현장명" android:textColor="#A0A0A5" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="여기에 입력하세요"
                    android:textColorHint="#55555A"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:layout_marginTop="4dp"
                    android:inputType="text" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A30" android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Input: 작업 내용 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="작업 내용" android:textColor="#A0A0A5" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="여기에 입력하세요"
                    android:textColorHint="#55555A"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:layout_marginTop="4dp"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A30" android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- GPS 위치 표시 (자동, 읽기 전용) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="14dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="위치 (GPS 자동)"
                        android:textColor="#A0A0A5"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="자동 수집"
                        android:textColor="#FF6F00"
                        android:textSize="11sp"
                        android:background="#1AFF6F00"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvGpsLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="위치를 가져오는 중..."
                    android:textColor="#808085"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A30" android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Input: 상세 위치 (수기) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="상세 위치 기록 (수기)" android:textColor="#A0A0A5" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDetailLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="동/호수, 층, 구역 등 상세 위치"
                    android:textColorHint="#55555A"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:layout_marginTop="4dp"
                    android:inputType="text" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A30" android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- Input: 메모 (비고) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="메모 (비고)" android:textColor="#A0A0A5" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="특이사항, 참고내용 등"
                    android:textColorHint="#55555A"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:layout_marginTop="4dp"
                    android:inputType="textMultiLine"
                    android:maxLines="4" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#2A2A30" android:layout_marginTop="10dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:background="#16161A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 사진 촬영 (가장 주요 기능 — 크게) -->
        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="사진 촬영"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#FF6F00"
            android:textAllCaps="false"
            app:cornerRadius="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="10dp" />

        <!-- 갤러리 1장 | 여러 장 배치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="갤러리 (단일)"
                android:textColor="#FF6F00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_outline_purple"
                android:layout_marginEnd="10dp"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBatch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="갤러리 (다수)"
                android:textColor="#FF6F00"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/btn_outline_purple"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#D4BFFF" />
        <TextView
            android:id="@+id/tvLoadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="처리 중..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
