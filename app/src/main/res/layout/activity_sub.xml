<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas">

    <!-- 헤더 -->
    <LinearLayout
        android:id="@+id/layoutSubHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CAPTURE FLOW"
            android:textColor="@color/teal_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
            android:id="@+id/tvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="현장 기록 작성"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDetailSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="워터마크 설정"
                android:textColor="@color/orange_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_neutral"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="현장 정보와 사진 작업을 한 화면에서 빠르게 끝낼 수 있게 작성 흐름을 압축했습니다."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutSubHeader"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp">

            <!-- Preview Image -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/surface_dark"
                app:strokeColor="@color/stroke_subtle"
                app:strokeWidth="1dp">
                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />
                <TextView
                    android:id="@+id/tvPreviewHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="14dp"
                    android:background="@drawable/bg_chip_neutral"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:text="탭해서 대표 미리보기 선택"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="기록 정보"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현장명, 작업 내용, 위치와 메모를 정리하면 사진 저장 흐름이 빨라집니다."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="현장명" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_panel"
                    android:hint="여기에 입력하세요"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Input: 작업 내용 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="작업 내용" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDesc"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_input_panel"
                    android:gravity="top"
                    android:hint="여기에 입력하세요"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"
                    android:padding="14dp"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />
            </LinearLayout>

            <!-- GPS 위치 표시 (자동, 읽기 전용) -->
            <LinearLayout
                android:id="@+id/layoutGpsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="위치 (GPS 자동)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="자동 수집"
                        android:textColor="#0F1115"
                        android:textSize="11sp"
                        android:background="@drawable/bg_chip_highlight"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tvGpsLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_panel"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="14dp"
                    android:text="위치를 가져오는 중..."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Input: 상세 위치 (수기) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="상세 위치 기록 (수기)" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etDetailLocation"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_panel"
                    android:hint="동/호수, 층, 구역 등 상세 위치"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="14dp"
                    android:inputType="text" />
            </LinearLayout>

            <!-- Input: 메모 (비고) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="0dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="메모 (비고)" android:textColor="@color/text_secondary" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etMemo"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:background="@drawable/bg_input_panel"
                    android:gravity="top"
                    android:hint="특이사항, 참고내용 등"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginTop="4dp"
                    android:padding="14dp"
                    android:inputType="textMultiLine"
                    android:maxLines="4" />
            </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 하단 버튼 영역 -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_bottom_nav_modern"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 수정 모드: 현재 사진으로 저장 (새 사진 없이 텍스트만 수정) -->
        <Button
            android:id="@+id/btnSaveKeepPhoto"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="현재 사진으로 저장"
            android:textColor="#091018"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="10dp"
            android:visibility="gone" />

        <!-- 사진 촬영 (가장 주요 기능 — 크게) -->
        <Button
            android:id="@+id/btnCamera"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="사진 촬영"
            android:textColor="#091018"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_primary_button"
            android:textAllCaps="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginBottom="10dp" />

        <!-- 갤러리 1장 | 여러 장 배치 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="갤러리 (단일)"
                android:textColor="@color/orange_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_secondary_button"
                android:layout_marginEnd="10dp"
                android:textAllCaps="false" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBatch"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="갤러리 (다수)"
                android:textColor="@color/orange_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_secondary_button"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>

    <!-- Loading overlay -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990A0D12"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">
        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/orange_primary" />
        <TextView
            android:id="@+id/tvLoadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="처리 중..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
