<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetInspectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_actual_luxury"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="점검 일정"
            android:textColor="#8F9FB0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:id="@+id/tvInspectionWidgetBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="4x2 추천"
            android:textColor="#8F9FB0"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvInspectionWidgetHeadline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="다가오는 점검 3건"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvInspectionItemOne"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_metric_tile"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:text="점검 일정을 등록해 주세요"
        android:textColor="#E4E8EE"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvInspectionItemTwo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_metric_tile"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:text="-"
        android:textColor="#C7D0DB"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvInspectionItemThree"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_metric_tile"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:text="-"
        android:textColor="#C7D0DB"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/layoutInspectionWidgetActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnInspectionOpenManager"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_primary"
            android:gravity="center"
            android:text="관리"
            android:textColor="#0F1115"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInspectionOpenArchive"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_secondary"
            android:gravity="center"
            android:text="보관함"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnInspectionRefresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_action_tile_secondary"
            android:gravity="center"
            android:text="새로고침"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
