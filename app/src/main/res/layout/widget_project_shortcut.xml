<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_actual_luxury"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_widget_preview_pill"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="현장 바로가기"
        android:textColor="#FFFFB36B"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetProjectTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="기록 없음"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetProjectMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="사진 0장"
        android:textColor="#D6DEE8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvWidgetProjectUpdatedAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="업데이트 00:00"
        android:textColor="#8F9FB0"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnWidgetOpenProject"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="열기"
            android:textColor="#0F1115"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWidgetAddSameProject"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:text="같은 현장 추가"
            android:textColor="#FFFFB36B"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWidgetExportPdf"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center"
            android:text="PDF"
            android:textColor="#FFFFB36B"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnWidgetProjectRefresh"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_secondary_button"
        android:gravity="center"
        android:text="최근 현장 정보 새로고침"
        android:textColor="#FFFFB36B"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
