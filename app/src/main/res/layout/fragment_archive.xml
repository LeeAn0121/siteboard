<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <TextView
        android:id="@+id/tvArchiveTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="프로젝트 보관함"
        android:textSize="24sp"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:layout_margin="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvArchiveDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="제목(프로젝트)별로 사진 개수를 모아봅니다."
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvArchiveTitle"
        app:layout_constraintStart_toStartOf="parent"/>

    <ListView
        android:id="@+id/lvProjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:divider="?android:attr/listDivider"
        android:dividerHeight="1dp"
        app:layout_constraintTop_toBottomOf="@id/tvArchiveDesc"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>