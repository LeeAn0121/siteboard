<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_preview_frame"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_widget_preview_luxury"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_preview_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="점검 일정"
            android:textColor="#FFFFB36B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="월별 점검까지 미리 확인"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_widget_metric_tile"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="강남 오피스 · 소방 점검 · D-14"
            android:textColor="#E4E8EE"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_widget_metric_tile"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp"
            android:text="판교 센터 · 분기 점검 · D-31"
            android:textColor="#C7D0DB"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="추천: 4x2 이상 배치"
            android:textColor="#8F9FB0"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
